# Secrets — NEVER commit
.env
credentials.json
*token*.json
*_token.json
*.key
*.pem

# Personal data — your private info
data/conversations/
data/briefings/
data/triages/
data/logs/
data/notes/
data/plans/
data/reviews/

# Keep memory templates in repo, but you may want to gitignore real data:
# Uncomment if you don't want to commit your personal memory files:
# data/memory/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
package-lock.json
yarn.lock

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Bridge env
bridge/.env

# Backups
*.bak
*.bak.md
data/memory/backup/

# Databases
*.sqlite
*.sqlite3
*.db
data/memory/graph.jsonl

# Episodic memory vector DB — regenerable from source files, would bloat repo
data/memory/chroma/

# Browser automation outputs
# Screenshots — binary, large, regenerable
data/browser/screenshots/
# Raw audit JSON — regenerable (keep *.md audit reports — small, valuable history)
data/browser/audits/*.json
# Login test reports — may contain site structure info
data/browser/login-tests/

# Incremental ingest marker (machine-specific timestamp)
data/markers/memory_last_ingest

# Runtime state (regenerated by scripts, not source-controlled)
data/hackathons/*.json
data/markers/*.json

# jarvis-core daemon runtime state (conversation history, session ids, task records)
data/state/

# Morning digest archive — daily snapshots, regenerable from daemon state
data/digests/

# Auto-mode audit log + screenshots (contain URLs Boss visited, action history)
data/audits/
# But DO keep the directory in repo as a placeholder for new clones
!data/audits/.gitkeep

# Browser autopilot — Chrome user profile (cookies, login sessions — never commit)
data/browser/profile/
# Sessions, cooldowns, daily counts — runtime data
data/career/sessions/
data/career/cooldown-*.json
data/career/applications.jsonl

# Eval framework — generated content
data/evals/_packages/
data/evals/reports/
data/evals/*/reports/

# Weekly reviews — may contain private context
data/reviews/

# Voice interface — audio files are large + may contain private speech
data/voice/recordings/
data/voice/transcripts/
data/voice/test/smoke_record.wav
# Voice models are downloaded on first use — don't commit 61MB ONNX
data/voice/models/
# Whisper model cache is in ~/.cache/whisper/ — user-level, not in repo
# Piper downloads go to data/voice/models/ — excluded above
