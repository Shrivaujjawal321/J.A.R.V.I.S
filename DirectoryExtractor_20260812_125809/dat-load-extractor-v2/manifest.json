{
  "manifest_version": 3,
  "name": "DAT Load Extractor V2",
  "version": "3.0.0",
  "description": "Deep DAT One load export — full detail traversal (route, rate, truck, contact, company, office) per load",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "*://*.dat.com/*",
    "*://one.dat.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DAT Load Extractor V2"
  },
  "side_panel": {
    "default_path": "popup.html?panel=true"
  },
  "content_scripts": [
    {
      "matches": ["*://*.dat.com/*", "*://one.dat.com/*"],
      "js": ["xlsx.full.min.js", "deep-extract.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.dat.com/*", "*://one.dat.com/*"],
      "js": ["inject-bypass.js", "net-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
