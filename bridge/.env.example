# Telegram Bot Setup
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Path to your Jarvis project (where CLAUDE.md is)
# Use absolute path
JARVIS_PROJECT_PATH=/Users/YOUR_USERNAME/projects/jarvis

# Restrict to your Telegram user IDs (comma-separated)
# Get your user ID from @userinfobot
# IMPORTANT: Set this in production. Otherwise anyone can use your bot.
ALLOWED_USER_IDS=123456789

# Claude Code timeout (seconds) — increase for complex tasks
CLAUDE_TIMEOUT=180

# Max tool-use turns per request — limits complexity
MAX_TURNS=15
