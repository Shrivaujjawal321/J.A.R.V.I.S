# =============================================================================
# AltBrief — Environment Variables Reference
# Copy to .env for local dev: cp .env.example .env
# Set secrets on Fly.io with: fly secrets set KEY=value
# Set on Vercel: Dashboard → Project → Settings → Environment Variables
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Backend will refuse to start without these
# ---------------------------------------------------------------------------

# Anthropic API key — get from https://console.anthropic.com
# Used by synthesizer.py (Claude Sonnet 4.6) + confidence scoring
ANTHROPIC_API_KEY=sk-ant-...

# EDGAR contact identity — SEC requires this in User-Agent header.
# Format: "AppName contact@yourdomain.com"
# Without this, SEC EDGAR will rate-limit to 10 req/s and may block.
EDGAR_IDENTITY=AltBrief contact@altbrief.com

# ---------------------------------------------------------------------------
# REQUIRED for live BrightData scraping (graceful degradation without it)
# If absent: reddit/linkedin/glassdoor/news sources return empty SourceResult
# with status=RATE_LIMITED; brief still generates from SEC + Yahoo + GDELT
# ---------------------------------------------------------------------------

# BrightData API token — get from https://brightdata.com → Account → API Token
# Used by: sources/reddit.py, linkedin.py, glassdoor.py, news.py
BRIGHTDATA_API_TOKEN=your_brightdata_token_here

# BrightData zone IDs (optional override — defaults pulled from MCP discovery)
# BRIGHTDATA_SERP_ZONE=serp_zone_id
# BRIGHTDATA_BROWSER_ZONE=scraping_browser_zone_id

# ---------------------------------------------------------------------------
# FRONTEND — set these on Vercel (NEXT_PUBLIC_ prefix = exposed to browser)
# ---------------------------------------------------------------------------

# URL of the deployed Fly.io backend. Browser connects here DIRECTLY for SSE.
# NEVER point this at a Next.js API route (10s Vercel timeout kills 45s stream).
# Local dev: http://localhost:8000
# Production: https://altbrief-api.fly.dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# CORS — Backend: who can call the FastAPI SSE endpoint
# FastAPI CORSMiddleware does NOT support wildcards in allow_origins.
# Workaround options:
#   Option A (simple): list all Vercel preview URLs explicitly here
#   Option B (recommended): use allow_origin_regex in main.py:
#     app.add_middleware(CORSMiddleware,
#       allow_origin_regex=r"https://altbrief.*\.vercel\.app",
#       ...)
#   Option C (demo-day fallback): add the specific preview URL Vercel assigns
# ---------------------------------------------------------------------------

# Comma-separated list. NO trailing slashes. NO wildcards (*).
# Include: localhost for dev, prod Vercel domain, specific preview URLs
CORS_ORIGINS=http://localhost:3000,https://altbrief.vercel.app

# ---------------------------------------------------------------------------
# OPTIONAL — Satellite layer (V2 feature, demo-only for XOM)
# ---------------------------------------------------------------------------

# NASA FIRMS Map Key — free at https://firms.modaps.eosdis.nasa.gov/api/area/
# Used by sources/satellite.py for thermal anomaly / flare detection
NASA_FIRMS_MAP_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Finance API fallbacks
# ---------------------------------------------------------------------------

# Tiingo API token — yfinance fallback when Yahoo blocks IP
# Free tier: 500 req/day. Get at https://www.tiingo.com/account/api/token
TIINGO_API_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — Observability (Langfuse cloud, free tier)
# If absent: structlog still works; Langfuse traces are skipped silently
# ---------------------------------------------------------------------------

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Default: Langfuse cloud. Point at self-hosted if needed.
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# OPTIONAL — Cost cap
# Default $5/day. Agent refuses new requests when cap exceeded.
# Reduce to $1 for development to avoid accidental spend.
# ---------------------------------------------------------------------------
DAILY_COST_CAP_USD=5.0

# ---------------------------------------------------------------------------
# OPTIONAL — Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_JSON=1 for production (JSON lines to stdout); 0 = pretty dev console
LOG_JSON=0
