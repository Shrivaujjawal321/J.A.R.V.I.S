# =============================================================================
# AltBrief .gitignore
# =============================================================================

# ---- Secrets — NEVER commit ----
.env
.env.*
!.env.example
!frontend/.env.local.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---- Test + lint artefacts ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ---- Runtime data — not source-controlled ----
.cache/
data/cost_tracker.json
data/cache/

# ---- Next.js ----
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ---- Vercel ----
.vercel/

# ---- OS ----
.DS_Store
Thumbs.db
*.swp
*.swo

# ---- IDE ----
.vscode/
.idea/
*.iml

# ---- Misc ----
*.log
*.tmp
