# =============================================================================
# AltBrief — Frontend Environment Variables
# Copy to .env.local: cp frontend/.env.local.example frontend/.env.local
# These are NEVER committed. .env.local is in .gitignore.
#
# For Vercel deployment, set these in:
#   Dashboard → Project → Settings → Environment Variables
# =============================================================================

# URL of the Fly.io backend.
# The browser opens an EventSource connection HERE directly — not through Vercel.
# This MUST be the public Fly.io URL in production.
# Vercel's 10s serverless timeout kills SSE streams — do NOT proxy through Next.js.
#
# Local dev:   http://localhost:8000
# Production:  https://altbrief-api.fly.dev  (set in Vercel dashboard)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# DO NOT add server-side secrets here.
# Any variable WITHOUT the NEXT_PUBLIC_ prefix is server-side only (RSC/Route Handlers).
# Since AltBrief's SSE stream is client-direct to Fly.io, there are no
# server-side API calls in the frontend — all env vars here are NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
