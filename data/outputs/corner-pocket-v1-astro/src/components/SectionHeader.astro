---
export interface Props {
  eyebrow: string;
  title: string;
  /** Optional accented word inside the title — will be wrapped in italic gold */
  accent?: string;
  intro?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, accent, intro, align = 'left' } = Astro.props;

// Replace the accent word with markup, preserving rest
const renderTitle = () => {
  if (!accent) return title;
  return title.replace(
    accent,
    `<span class="italic font-normal text-gold">${accent}</span>`
  );
};
---

<div class={`reveal ${align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-2xl'}`}>
  <p class="eyebrow mb-5">
    {align === 'left' && <span class="inline-block h-px w-8 align-middle bg-gold mr-3"></span>}
    {eyebrow}
    {align === 'center' && <span class="inline-block h-px w-8 align-middle bg-gold ml-3"></span>}
  </p>
  <h2
    class="font-display text-4xl sm:text-5xl md:text-6xl leading-[1.05] tracking-tight text-cream mb-6"
    set:html={renderTitle()}
  />
  {
    intro && (
      <p class="text-base sm:text-lg text-cream-muted leading-relaxed font-serif">
        {intro}
      </p>
    )
  }
</div>
