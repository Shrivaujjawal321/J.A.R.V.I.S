[Unit]
Description=Jarvis Morning Digest — daily at 06:30 IST
Documentation=file:///home/ujjwal/Documents/J.A.R.V.I.S./CLAUDE.md

[Timer]
# 06:30 IST = 01:00 UTC. Run with persistence so missed runs (laptop asleep) fire on wake.
OnCalendar=*-*-* 01:00:00
Persistent=true
RandomizedDelaySec=120
Unit=jarvis-morning-digest.service

[Install]
WantedBy=timers.target
