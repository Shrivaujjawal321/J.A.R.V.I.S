[Unit]
Description=Jarvis Self-Growth Weekly — Sunday 20:00 IST
Documentation=file:///home/ujjwal/Documents/J.A.R.V.I.S./specs/self-growth.spec.md

[Timer]
# Sunday 20:00 IST = Sunday 14:30 UTC. Persistent fires on next boot if missed.
OnCalendar=Sun *-*-* 14:30:00
Persistent=true
RandomizedDelaySec=300
Unit=jarvis-self-growth.service

[Install]
WantedBy=timers.target
